# =============================================================================
# CodeMind — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM (Groq) ---
# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# --- Vector Store (Qdrant) ---
# Points to the Qdrant container in Docker Compose
QDRANT_URL=http://qdrant:6333

# --- Embeddings (STAPI — sentence-transformers) ---
# Points to the stapi container in Docker Compose
STAPI_URL=http://stapi:8080/v1/embeddings

# --- Database (MongoDB — keep current in Phase 1, migrate in Phase 2) ---
MONGO_URI=mongodb://mongo:27017/codemind

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string_in_production

# --- Service URLs (internal Docker network) ---
AI_SERVICE_URL=http://agent:8000

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# --- Ports ---
PORT=5000
